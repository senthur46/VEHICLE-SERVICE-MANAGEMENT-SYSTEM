CREATE DATABASE IF NOT EXISTS vehicle_service;
USE vehicle_service;
CREATE TABLE IF NOT EXISTS vehicle (
reg_no VARCHAR(10) PRIMARY KEY,
vehicle_type VARCHAR(5) NOT NULL,
owner_name VARCHAR(50) NOT NULL,
phone CHAR(10) NOT NULL,
model VARCHAR(40) NOT NULL,
load_tons DECIMAL(4,1) NULL
);
CREATE TABLE IF NOT EXISTS service_type (
type_code VARCHAR(20) PRIMARY KEY,
label VARCHAR(30) NOT NULL,
labour_cost DECIMAL(8,2) NOT NULL CHECK (labour_cost >= 0)
);
INSERT IGNORE INTO service_type VALUES
('GENERAL_SERVICE', 'General Service', 1000),
('OIL_CHANGE', 'Oil Change', 800),
('WHEEL_ALIGNMENT', 'Wheel Alignment', 600),
('BRAKE_REPAIR', 'Brake Repair', 1200),
('WASHING', 'Washing & Cleaning', 300);
CREATE TABLE IF NOT EXISTS service_record (
job_id INT PRIMARY KEY AUTO_INCREMENT,
reg_no VARCHAR(10) NOT NULL,
type_code VARCHAR(20) NOT NULL,
parts_cost DECIMAL(8,2) NOT NULL DEFAULT 0 CHECK (parts_cost >= 0),
status VARCHAR(12) NOT NULL DEFAULT 'PENDING'
CHECK (status IN ('PENDING', 'IN_PROGRESS', 'COMPLETED')),
service_date DATE NOT NULL,
FOREIGN KEY (reg_no) REFERENCES vehicle(reg_no),
FOREIGN KEY (type_code) REFERENCES service_type(type_code)
) AUTO_INCREMENT = 1001;
